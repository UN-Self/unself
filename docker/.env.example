# SPDX-License-Identifier: AGPL-3.0-only
# docker compose 变量清单：cp docker/.env.example docker/.env 后按需改。
# 每项等号右侧是默认值；注释写明用途。

# ---- 镜像版本 ----------------------------------------------------------------
# 镜像是装发布包：npm i -g @unself/workbench@$UNSELF_VERSION（跟裸机同一个 bin）。
# 填 npm dist-tag 或精确版本号，不是 git ref。
#   latest（默认，正式部署）/ test（联调测试包）/ 0.1.2
# 改完要重建镜像才生效：docker compose -f docker/compose.yml up --build -d
UNSELF_VERSION=latest

# ---- 容器网络 ----------------------------------------------------------------
# 宿主暴露端口。容器内固定 8787；改这里只影响宿主机映射。
UNSELF_PORT=8787
# dev profile（源码构建未发布分支）用的宿主端口，默认 8788，避免与正式实例撞。
UNSELF_PORT_DEV=8788

# 对外基础地址（反代/远程访问必设）。首启一次性 setup 深链接按它拼；留空 = http://localhost:8787。
# 例：UNSELF_BASE_URL=https://unself.example.com
UNSELF_BASE_URL=

# ---- 数据库 ------------------------------------------------------------------
# 数据库方言由 scheme 决定，Node 入口自己分发 + 跑迁移。
#   sqlite（默认）：sqlite:///app/data/core.db   —— 落 unself-data 卷，单容器即用
#   sqlite 内存（仅调试）：sqlite://:memory:      —— 重启即丢，勿用于正式部署
#   PostgreSQL：postgres://unself:unself@postgres:5432/unself
#     ↳ 主机名 postgres 是 compose 服务名；改用它时启动要加 --profile pg。
UNSELF_DB=sqlite:///app/data/core.db

# ---- 头像存储 ----------------------------------------------------------------
# 留空 = 头像能力关闭（与未绑定的现状同义）。两种形态：
#   本地目录：local:/app/data/avatars   —— 目录须在数据卷内才持久
#   S3 兼容（MinIO 示例，minioadmin 是 MinIO 默认账密，生产务必换）：
#     s3://unself?endpoint=http://minio:9000&region=us-east-1&accessKeyId=minioadmin&secretAccessKey=minioadmin&forcePathStyle=1
#   forcePathStyle=1：把 bucket 放进路径（http://host/bucket/key）而不是子域名
#   （http://bucket.host/key）。MinIO 与多数自建网关必须开 1；AWS S3 可留 0/不写。
#   accessKeyId / secretAccessKey 必填；region 缺省 us-east-1。
UNSELF_FILES=

# ---- 实例签名私钥 -------------------------------------------------------------
# 留空 = 首启自动生成 jwt_private_key.pem 落数据卷（0600），容器重建沿用；卷丢弃即换钥。
# 需要自带密钥时填 PEM（多行值在 .env 里不好写，通常保持留空）。
JWT_PRIVATE_KEY=

# ---- PostgreSQL（--profile pg 时才用到）-------------------------------------
POSTGRES_USER=unself
POSTGRES_PASSWORD=unself
POSTGRES_DB=unself
# 切 PG 时 UNSELF_DB 同步改成：postgres://unself:unself@postgres:5432/unself
