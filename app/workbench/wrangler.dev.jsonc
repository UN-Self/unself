// SPDX-License-Identifier: AGPL-3.0-only
// 本地开发专用（wrangler dev）；生产部署一律走装配器：
// `npx @unself/installer` 在 .deploy/cloudflare/ 生成带真实 database_id 与模块绑定的
// 独立配置，本文件的 REPLACE_ME 永远不会出现在生产。
//
// 日常入口：`pnpm dev`（scripts/dev.mjs）——自动 vite build（dist/web 缺失时）+
// 自动迁移（d1_migrations 记账）+ 自生成 .dev.vars + 起 wrangler dev。
// 手动等价：先 `pnpm build:web`，再 `npx wrangler dev --config wrangler.dev.jsonc`。
//
// 本地完整形态（#182）：
// - main 指 test/dev-entry.ts：进程内单例假邮件适配器（批准→激活跨请求可见）；
// - assets 指 dist/web：SPA fallback + API/JWKS 一律先跑 Worker（同装配器生成形态）；
// - 密钥走 .dev.vars（JWT_PRIVATE_KEY 单行 env，dev.mjs 自动生成；也兼容
//   JWT_PRIVATE_KEY_BASE64，见 .dev.vars.example）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unself-workbench-dev",
  "main": "test/dev-entry.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    // SPA：未命中文件回 index.html；API/JWKS 一律先跑 Worker（同装配器生成形态）
    "not_found_handling": "single-page-application",
    // /m/* 也经 worker：connect 反连模块的数据面出口（隧道转发）在这里，#349
    "run_worker_first": ["/api/*", "/.well-known/*", "/m/*"]
  },
  // #349 隧道 DO：connect 反连模块的数据面出口（hibernation 省费；决策 #106 过渡事实）
  "durable_objects": {
    "bindings": [{ "name": "CONNECT_TUNNEL", "class_name": "TunnelRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelRoom"] }],
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "unself-core",
      // database_id：本地 miniflare 只当存储 key 用，REPLACE_ME 占位即可（生产由装配器替换）
      "database_id": "REPLACE_ME",
      // migrations_dir：CORE_DB 迁移在本包 migrations/core/（wrangler d1 migrations apply CORE_DB）
      "migrations_dir": "migrations/core"
    },
    {
      "binding": "MODULES_DB",
      "database_name": "unself-modules",
      "database_id": "REPLACE_ME"
      // migrations_dir：MODULES_DB 迁移由各 module 包自管（如 app/modules/hello/migrations/hello/）
    }
  ]
}
