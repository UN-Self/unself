// SPDX-License-Identifier: AGPL-3.0-only
// ⚠️ 占位文件——不可直接用来手动部署（#194 D6）。
// 这里的 database_id 是 REPLACE_ME 占位符，`wrangler deploy` 照它跑必然失败；
// 生产部署一律走装配器：`npx @unself/installer`（它会用真实 database_id
// 在 .deploy/cloudflare/ 生成 core.wrangler.jsonc，见 app/installer/src/engine/assemble.ts）。
// 本文件仅保留给 workbench 本地开发参考（如 wrangler dev / d1 migrations 本地调试）。
{
  "name": "unself-workbench",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "unself-core",
      "database_id": "REPLACE_ME",
      // migrations_dir：CORE_DB 迁移在本包 migrations/core/（wrangler d1 migrations apply CORE_DB）
      "migrations_dir": "migrations/core"
    },
    {
      "binding": "MODULES_DB",
      "database_name": "unself-modules",
      "database_id": "REPLACE_ME"
      // migrations_dir：MODULES_DB 迁移由各 module 包自管（如 app/modules/hello/migrations/hello/）
    }
  ]
}
