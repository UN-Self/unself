{
  "name": "@unself/workbench",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UN-Self/unself.git",
    "directory": "app/workbench"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm build:worker && vite build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:worker": "tsx scripts/build-worker.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@unself/contracts": "workspace:*",
    "@unself/mail-smtp": "workspace:*",
    "@unself/sdk": "workspace:*",
    "@unself/stalwart-provisioner": "workspace:*",
    "@unself/ui": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.0",
    "esbuild": "^0.28.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "jsdom": "^27.4.0",
    "lucide-vue-next": "^0.544.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0",
    "zod": "^4.1.0"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "description": "Unself 平台运行体（一个包两半边）：core Worker（后端）+ 工作台 SPA（前端）+ 迁移 SQL；发布预构建产物，由 @unself/installer 装配"
}
