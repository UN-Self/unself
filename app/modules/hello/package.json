{
  "name": "@unself/hello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build && cp dist/worker.js worker.js",
    "dev": "tsx --env-file=.env src/main.ts",
    "postpack": "rm -f worker.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "hono": "^4.10.0",
    "@unself/sdk": "workspace:*",
    "@unself/contracts": "workspace:*",
    "jose": "^6.1.0"
  },
  "bin": {
    "unself-hello": "./dist/main.js"
  },
  "files": [
    "dist",
    "worker.js"
  ]
}