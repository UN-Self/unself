{
  "name": "@unself/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./node": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "dev": "pnpm --filter @unself/sdk run build && pnpm run build && node --env-file-if-exists=.env dist/main.js"
  },
  "bin": {
    "unself-docs": "./dist/main.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@unself/contracts": "workspace:*",
    "@unself/sdk": "workspace:*",
    "esbuild": "^0.28.0",
    "jose": "^6.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
